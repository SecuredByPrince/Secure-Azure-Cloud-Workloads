// ============================================================
// VM-Security-Events.kql
// Secure Azure Cloud Workloads
// ============================================================
// Description:
// Retrieves VM security-related events to improve
// workload visibility, telemetry correlation,
// operational investigations, and governance awareness.
// ============================================================



// ============================================================
// 1. General VM Security Events
// Retrieve security events from virtual machines
// ============================================================

SecurityEvent
| project
    TimeGenerated,
    Computer,
    EventID,
    Activity,
    Account,
    AccountType,
    LogonType,
    RenderedDescription
| order by TimeGenerated desc



// ============================================================
// 2. Failed Logon Attempts
// Detect failed authentication activity on VMs
// ============================================================

SecurityEvent
| where EventID == 4625
| project
    TimeGenerated,
    Computer,
    Account,
    IpAddress,
    LogonType,
    FailureReason=RenderedDescription
| order by TimeGenerated desc



// ============================================================
// 3. Successful Logon Events
// Review successful VM authentication activity
// ============================================================

SecurityEvent
| where EventID == 4624
| project
    TimeGenerated,
    Computer,
    Account,
    IpAddress,
    LogonType,
    Activity
| order by TimeGenerated desc



// ============================================================
// 4. Privileged Account Activity
// Detect administrative or privileged operations
// ============================================================

SecurityEvent
| where EventID in (4672, 4728, 4732)
| project
    TimeGenerated,
    Computer,
    Account,
    EventID,
    Activity,
    RenderedDescription
| order by TimeGenerated desc



// ============================================================
// 5. Account Lockout Visibility
// Detect account lockout activity
// ============================================================

SecurityEvent
| where EventID == 4740
| project
    TimeGenerated,
    Computer,
    Account,
    Activity,
    RenderedDescription
| order by TimeGenerated desc



// ============================================================
// 6. RDP Authentication Visibility
// Detect Remote Desktop authentication activity
// ============================================================

SecurityEvent
| where EventID in (4624, 4625)
| where LogonType == 10
| project
    TimeGenerated,
    Computer,
    Account,
    IpAddress,
    EventID,
    Activity
| order by TimeGenerated desc



// ============================================================
// 7. PowerShell Activity Visibility
// Review PowerShell operational activity
// ============================================================

Event
| where Source == "PowerShell"
| project
    TimeGenerated,
    Computer,
    EventLevelName,
    RenderedDescription
| order by TimeGenerated desc



// ============================================================
// 8. VM Heartbeat Visibility
// Detect disconnected or inactive VMs
// ============================================================

Heartbeat
| summarize LastHeartbeat=max(TimeGenerated)
    by Computer
| order by LastHeartbeat asc



// ============================================================
// 9. Suspicious Authentication Patterns
// Detect repeated failed authentication attempts
// ============================================================

SecurityEvent
| where EventID == 4625
| summarize FailedAttempts=count()
    by Computer, Account, IpAddress
| where FailedAttempts >= 5
| order by FailedAttempts desc



// ============================================================
// 10. VM Security Event Severity Overview
// Summarize security events by Event ID
// ============================================================

SecurityEvent
| summarize EventCount=count()
    by EventID
| order by EventCount desc
